<%- include('../partials/header', { title }) %>
<main class="admin-page container-fluid">
  <header class="admin-heading"><div><p class="eyebrow">Maison Atelier · Product management</p><h1><%= productId ? 'Edit product' : 'Add product' %></h1></div><a class="admin-inline-link" href="/admin/products"><i class="bi bi-arrow-left"></i> All products</a></header>
  <%- include('_nav') %>
  <% if (error) { %><p class="admin-form-error" role="alert"><%= error %></p><% } %>
  <form class="admin-product-form" action="<%= productId ? `/admin/products/${productId}` : '/admin/products' %>" method="post" enctype="multipart/form-data">
    <div class="admin-form-grid">
      <label>Product name<input name="name" value="<%= values.name || '' %>" maxlength="120" required></label>
      <label>Slug<input name="slug" value="<%= values.slug || '' %>" maxlength="120" placeholder="Generated from name when blank"></label>
      <label>Category<input name="category" value="<%= values.category || '' %>" maxlength="64" required></label>
      <label>Subcategory<input name="subcategory" value="<%= values.subcategory || '' %>" maxlength="64"></label>
      <label>Brand<input name="brand" value="<%= values.brand || 'Maison Atelier' %>" maxlength="80"></label>
      <label>Price (€)<input name="price" type="number" min="0" step="0.01" value="<%= values.price ?? '' %>" required></label>
      <label>Discount price (€)<input name="discountPrice" type="number" min="0" step="0.01" value="<%= values.discountPrice ?? '' %>"></label>
      <label>Stock<input name="stock" type="number" min="0" step="1" value="<%= values.stock ?? '0' %>" required></label>
      <label class="admin-full-width">Description<textarea name="description" rows="5" maxlength="5000" required><%= values.description || '' %></textarea></label>
      <label>Sizes <small>Comma or line separated</small><textarea name="sizes" rows="3"><%= values.sizesText || '' %></textarea></label>
      <label>Colors <small>Comma or line separated</small><textarea name="colors" rows="3"><%= values.colorsText || '' %></textarea></label>
      <% if (productId) { %>
        <div class="admin-full-width admin-edit-image-upload" data-edit-image-upload>
          <div class="admin-edit-image-controls">
            <label>Image URLs <small>One HTTP(S) URL or saved upload path per line. Selected files replace images in matching order; additional files are appended.</small><textarea name="images" rows="3" data-edit-image-urls><%= values.imagesText || '' %></textarea></label>
            <label class="admin-edit-image-picker">Choose local replacement images <small>JPG, JPEG, PNG, WebP, or AVIF · up to 5 MB each · maximum 8 images</small><input class="admin-image-input" name="imageFiles" type="file" accept=".jpg,.jpeg,.png,.webp,.avif,image/jpeg,image/png,image/webp,image/avif" multiple data-edit-image-files></label>
          </div>
          <p class="admin-image-upload-status" data-edit-image-status aria-live="polite">No local replacement images selected.</p>
          <div class="admin-image-previews" data-edit-image-previews></div>
        </div>
      <% } else { %>
        <div class="admin-full-width admin-image-upload" data-product-image-upload>
          <p class="admin-image-upload-label">Product images <small>JPEG, PNG, WebP, or AVIF · up to 5 MB each · maximum 8 images</small></p>
          <input class="admin-image-input" id="product-images" name="images" type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple tabindex="-1" aria-hidden="true">
          <button class="admin-image-dropzone" type="button" data-image-dropzone aria-controls="product-images">
            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
            <span>Drop images here or <u>browse files</u></span>
          </button>
          <p class="admin-image-upload-status" data-image-upload-status aria-live="polite">No images selected.</p>
          <div class="admin-image-previews" data-image-previews></div>
        </div>
      <% } %>
      <label class="admin-check"><input type="checkbox" name="featured" <%= values.featured ? 'checked' : '' %>> Featured</label>
      <label class="admin-check"><input type="checkbox" name="newArrival" <%= values.newArrival ? 'checked' : '' %>> New arrival</label>
    </div>
    <div class="admin-form-actions"><button class="admin-primary-link" type="submit"><%= productId ? 'Save product' : 'Create product' %></button><a href="/admin/products">Cancel</a></div>
  </form>
</main>
<% if (!productId) { %><script src="/js/admin-product-upload.js" defer></script><% } %>
<% if (productId) { %><script src="/js/admin-product-edit-images.js" defer></script><% } %>
<%- include('../partials/footer') %>
