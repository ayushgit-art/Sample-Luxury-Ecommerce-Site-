<%- include('../partials/header', { title }) %>
<main class="admin-page container-fluid">
  <header class="admin-heading"><div><p class="eyebrow">Maison Atelier · Administration</p><h1>Orders</h1></div></header>
  <%- include('_nav') %>
  <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Status</th><th>Payment</th><th>Total</th><th></th></tr></thead><tbody>
    <% orders.forEach((order) => { %><tr><td>#<%= String(order._id).slice(-8).toUpperCase() %></td><td><%= order.user ? order.user.name : 'Account removed' %><small class="admin-cell-sub"><%= order.contactEmail || (order.user && order.user.email) || '' %></small></td><td><%= new Date(order.createdAt).toLocaleDateString('en-GB') %></td><td class="status-<%= order.orderStatus %>"><%= order.orderStatus %></td><td><%= order.paymentStatus %></td><td>€<%= Number(order.total).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td><td><a href="/admin/orders/<%= order._id %>">View</a></td></tr><% }) %>
  </tbody></table></div>
  <% if (!orders.length) { %><p class="admin-empty-note">No orders have been placed.</p><% } %>
</main>
<%- include('../partials/footer') %>
