<%- include('partials/header', { title }) %>
<main class="orders-page container-fluid">
  <header class="orders-heading">
    <p class="eyebrow">Maison Atelier · Private account</p>
    <h1>Order history</h1>
    <p>Your past orders, held in one place.</p>
  </header>
  <% if (orders.length) { %>
    <section class="orders-list" aria-label="Your orders">
      <% orders.forEach((order) => { const orderNumber = String(order._id).slice(-8).toUpperCase(); %>
        <a class="order-history-row" href="/orders/<%= order._id %>">
          <span class="order-reference"><small>Order</small><strong>#<%= orderNumber %></strong><small><%= new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></small></span>
          <span class="order-preview"><% order.items.slice(0, 2).forEach((item) => { if (item.image) { %><img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy"><% } else { %><span class="order-image-placeholder" aria-hidden="true"></span><% } }) %><span><%= order.items.length %> <%= order.items.length === 1 ? 'piece' : 'pieces' %></span></span>
          <span class="order-history-status"><small>Order status</small><strong class="status-<%= order.orderStatus %>"><%= order.orderStatus %></strong></span>
          <span class="order-history-total"><small>Total</small><strong>€<%= formatPrice(order.total) %></strong></span>
          <i class="bi bi-arrow-up-right order-row-arrow" aria-hidden="true"></i>
        </a>
      <% }) %>
    </section>
  <% } else { %>
    <section class="orders-empty">
      <p>Your story with the atelier begins when you are ready.</p>
      <a class="text-cta dark-cta" href="/products">Explore the collection <i class="bi bi-arrow-right"></i></a>
    </section>
  <% } %>
  <a class="account-return-link" href="/account"><i class="bi bi-arrow-left"></i> Back to your account</a>
</main>
<%- include('partials/footer') %>
