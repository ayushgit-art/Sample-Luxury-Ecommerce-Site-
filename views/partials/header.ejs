<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f5f0">
  <meta name="description" content="Considered pieces for a life well lived. Discover Maison Atelier shoes, clothing, handbags and leather goods.">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body data-authenticated="<%= currentUser ? 'true' : 'false' %>">
  <div class="announcement">Complimentary delivery on all orders over €500</div>
  <header class="site-header">
    <nav class="navbar navbar-expand-lg site-nav" aria-label="Main navigation">
      <div class="container-fluid site-nav-inner">
        <button class="navbar-toggler nav-icon-button order-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <a class="navbar-brand brand-mark order-1 order-lg-1" href="/" aria-label="Maison Atelier home">MAISON <span>ATELIER</span></a>
        <div class="nav-utilities order-2 order-lg-3">
          <a href="/shop" class="utility-link d-none d-md-inline">Find a boutique</a>
          <a class="nav-icon-button search-toggle" href="/products#searchProducts" aria-label="Search"><i class="bi bi-search"></i></a>
          <% if (currentUser && currentUser.role === 'admin') { %><a class="nav-icon-button admin-nav-link" href="/admin" aria-label="Administration"><i class="bi bi-speedometer2"></i></a><% } %>
          <a href="/wishlist" class="nav-icon-button wishlist-nav-link" aria-label="Your wishlist"><i class="bi bi-heart"></i></a>
          <a href="<%= currentUser ? '/account' : '/login' %>" class="nav-icon-button account-link" aria-label="<%= currentUser ? 'Your account' : 'Sign in' %>"><i class="bi bi-person"></i></a>
          <% if (currentUser) { %><form class="logout-form" action="/logout" method="post"><button class="nav-icon-button" type="submit" aria-label="Sign out"><i class="bi bi-box-arrow-right"></i></button></form><% } %>
          <a href="/cart" class="nav-icon-button bag-link" aria-label="Shopping bag"><i class="bi bi-bag"></i><span class="bag-count" data-bag-count>0</span></a>
        </div>
        <div class="collapse navbar-collapse order-3 order-lg-2" id="mainNavigation">
          <ul class="navbar-nav nav-categories">
            <li class="nav-item"><a class="nav-link" href="/shop?category=Ready-to-wear">Ready-to-wear</a></li>
            <li class="nav-item"><a class="nav-link" href="/shop?category=Shoes">Shoes</a></li>
            <li class="nav-item"><a class="nav-link" href="/shop?category=Bags">Bags</a></li>
            <li class="nav-item"><a class="nav-link" href="/shop?category=Accessories">Accessories</a></li>
            <li class="nav-item"><a class="nav-link" href="/#atelier">The atelier</a></li>
          </ul>
        </div>
      </div>
    </nav>
  </header>
